# Skopiuj do terraform.tfvars i uzupełnij wartości
# NIGDY nie commituj terraform.tfvars z prawdziwymi danymi!

project_name = "devops-diploma"
aws_region   = "eu-central-1"

# Twoje publiczne IP — sprawdź: curl ifconfig.me
admin_cidr = "YOUR_PUBLIC_IP/32"

# Zawartość pliku ~/.ssh/devops-diploma.pub
ssh_public_key = "ssh-rsa AAAA... your-key-here"

jenkins_instance_type = "t3.small"
k3s_instance_type     = "t3.small"

# WAŻNE: pusty string = NOWY pusty dysk (utrata Jenkins credentials).
# Po pierwszym apply skrypty zapisują vol- do .secrets/jenkins-home-volume-id.txt
# i tu. Start/resume ZAWSZE reuse tego ID.
# Pierwszy bootstrap: start-from-zero.ps1 -AllowNewJenkinsVolume
jenkins_home_volume_id = ""
jenkins_home_volume_size_gb = 20
