// CI dla repo infra (nie aplikacji).
// W Multibranch: Script Path = jenkins/Jenkinsfile.ci

pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds(abortPrevious: true)
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Layout check') {
            steps {
                sh '''
                    set -e
                    test -d terraform
                    test -d ansible
                    test -d kubernetes
                    test -f kubernetes/apps/backend.yaml
                    test -f kubernetes/apps/web.yaml
                    echo "INFRA_LAYOUT_OK"
                '''
            }
        }

        stage('Kubernetes dry-run') {
            steps {
                sh '''
                    set -e
                    if ! command -v kubectl >/dev/null 2>&1; then
                        echo "kubectl missing — skip dry-run"
                        exit 0
                    fi
                    for f in kubernetes/apps/*.yaml kubernetes/monitoring/*.yaml; do
                        [ -f "$f" ] || continue
                        # Helm values — nie jest manifestem K8s
                        case "$f" in
                          *kube-prometheus-values.yaml|*values.yaml) echo "skip helm values: $f"; continue ;;
                        esac
                        echo "validate: $f"
                        kubectl apply --dry-run=client -f "$f"
                    done
                    echo "K8S_DRY_RUN_OK"
                '''
            }
        }

        stage('Ansible syntax') {
            steps {
                sh '''
                    set -e
                    if ! command -v ansible-playbook >/dev/null 2>&1; then
                        echo "ansible-playbook missing — skip syntax check"
                        exit 0
                    fi
                    cd ansible
                    for pb in playbooks/*.yml; do
                        echo "syntax: $pb"
                        ansible-playbook --syntax-check -i inventory/hosts "$pb" || \
                          ansible-playbook --syntax-check "$pb"
                    done
                    echo "ANSIBLE_SYNTAX_OK"
                '''
            }
        }
    }
}
