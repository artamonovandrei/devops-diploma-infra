// CI dla repo infra (nie aplikacji).
// W Multibranch: Script Path = jenkins/Jenkinsfile.ci

pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds(abortPrevious: true)
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Layout check') {
            steps {
                sh '''
                    set -e
                    test -d terraform
                    test -d ansible
                    test -d kubernetes
                    test -f kubernetes/apps/backend.yaml
                    test -f kubernetes/apps/web.yaml
                    echo "INFRA_LAYOUT_OK"
                '''
            }
        }

        stage('Kubernetes dry-run') {
            steps {
                sh '''
                    set -e
                    if ! command -v kubectl >/dev/null 2>&1; then
                        echo "kubectl missing — skip dry-run"
                        exit 0
                    fi
                    # --validate=false: nie wymaga żywego API (kubeconfig może mieć stare IP po resume)
                    for f in kubernetes/apps/*.yaml kubernetes/monitoring/stack.yaml; do
                        [ -f "$f" ] || continue
                        echo "validate: $f"
                        kubectl apply --dry-run=client --validate=false -f "$f"
                    done
                    echo "K8S_DRY_RUN_OK"
                '''
            }
        }

        stage('Ansible syntax') {
            steps {
                sh '''
                    set -e
                    if ! command -v ansible-playbook >/dev/null 2>&1; then
                        echo "ansible-playbook missing — skip syntax check"
                        exit 0
                    fi
                    cd ansible
                    INV=inventory/hosts.example
                    [ -f inventory/hosts ] && INV=inventory/hosts
                    for pb in playbooks/site.yml playbooks/monitoring.yml playbooks/jenkins.yml playbooks/k3s.yml; do
                        [ -f "$pb" ] || continue
                        echo "syntax: $pb"
                        ansible-playbook --syntax-check -i "$INV" "$pb"
                    done
                    echo "ANSIBLE_SYNTAX_OK"
                '''
            }
        }

        // Po zielonym CI na develop → merge do main.
        // Credential ID: github-token = Username with password (PAT scope: repo)
        stage('Promote develop to main') {
            when {
                branch 'develop'
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                    sh '''
                        set -e
                        REPO_URL="https://${GIT_USER}:${GIT_PASS}@github.com/artamonovandrei/devops-diploma-infra.git"
                        WORK="$(mktemp -d /tmp/infra-promote.XXXXXX)"
                        cleanup() { rm -rf "$WORK"; }
                        trap cleanup EXIT

                        git clone --depth 50 --no-single-branch "$REPO_URL" "$WORK"
                        cd "$WORK"
                        git config user.name "artamonovandrei"
                        git config user.email "artamonovandrei88@gmail.com"

                        git fetch origin main develop
                        git checkout -B main origin/main
                        git merge --ff-only origin/develop || \
                          git merge --no-ff origin/develop -m "Auto-merge develop → main (CI #${BUILD_NUMBER} OK)"

                        BEFORE=$(git rev-parse origin/main)
                        AFTER=$(git rev-parse HEAD)
                        if [ "$BEFORE" = "$AFTER" ]; then
                          echo "AUTO_MERGE_SKIP develop already in main"
                        else
                          git push origin HEAD:main
                          echo "AUTO_MERGE_OK"
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                def mailSubject = "[DevOps Diploma] ${env.JOB_NAME} #${env.BUILD_NUMBER} - ${currentBuild.currentResult}"
                def mailBody = """Pipeline finished.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Branch: ${env.BRANCH_NAME}
Status: ${currentBuild.currentResult}
URL: ${env.BUILD_URL}
"""
                try {
                    withCredentials([usernamePassword(credentialsId: 'ses-smtp', usernameVariable: 'SMTP_USER', passwordVariable: 'SMTP_PASS')]) {
                        sh """
                            python3 - <<'PY'
import os, smtplib, ssl
from email.message import EmailMessage
from email.utils import formataddr, formatdate, make_msgid

user = os.environ['SMTP_USER']
password = os.environ['SMTP_PASS']
from_addr = 'artamonovandrei88@gmail.com'
to_addr = os.environ.get('SES_TO', 'a.artamonov@wp.pl')
subject = '''${mailSubject}'''
body = '''${mailBody}'''

msg = EmailMessage()
msg['Subject'] = subject
msg['From'] = formataddr(('Infra CI', from_addr))
msg['To'] = to_addr
msg['Date'] = formatdate(localtime=True)
msg['Message-ID'] = make_msgid(domain='eu-central-1.amazonses.com')
msg['Reply-To'] = from_addr
msg['X-Mailer'] = 'devops-diploma-infra-Jenkins'
msg.set_content(body)

ctx = ssl.create_default_context()
with smtplib.SMTP('email-smtp.eu-central-1.amazonaws.com', 587, timeout=30) as s:
    s.ehlo()
    s.starttls(context=ctx)
    s.ehlo()
    s.login(user, password)
    s.send_message(msg)
print('SES_EMAIL_SENT_OK to=' + to_addr)
PY
                        """
                    }
                } catch (err) {
                    echo "SES mail failed: ${err}"
                }
            }
        }
    }
}
